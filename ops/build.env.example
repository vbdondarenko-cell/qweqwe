# Copy to /etc/linkup/build.env on the Ubuntu build server.
# Never commit the populated file. Recommended mode: 0640 root:<build-user-group>.

# Firebase Android client configuration (not service-account credentials).
ORG_GRADLE_PROJECT_LINKUP_FIREBASE_API_KEY=
ORG_GRADLE_PROJECT_LINKUP_FIREBASE_APP_ID=
ORG_GRADLE_PROJECT_LINKUP_FIREBASE_PROJECT_ID=
ORG_GRADLE_PROJECT_LINKUP_FIREBASE_SENDER_ID=

# Release API/legal/App Link configuration.
ORG_GRADLE_PROJECT_LINKUP_API_BASE_URL=
ORG_GRADLE_PROJECT_LINKUP_PRIVACY_URL=
ORG_GRADLE_PROJECT_LINKUP_TERMS_URL=
ORG_GRADLE_PROJECT_LINKUP_RESET_HOST=

# Android release signing. Point to the actual JKS/keystore stored outside Git.
ORG_GRADLE_PROJECT_LINKUP_KEYSTORE_FILE=/etc/linkup/linkup-release-key.jks
ORG_GRADLE_PROJECT_LINKUP_KEYSTORE_PASSWORD=
ORG_GRADLE_PROJECT_LINKUP_KEY_ALIAS=
ORG_GRADLE_PROJECT_LINKUP_KEY_PASSWORD=

# Set to 1 only when all release prerequisites above are configured.
LINKUP_BUILD_RELEASE=0
