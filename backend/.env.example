# Safe example only. Never commit real credentials.
LINKUP_HTTP_ADDR=:8080
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
LINKUP_SESSION_TTL=720h
LINKUP_PASSWORD_RESET_TTL=30m
LINKUP_IDEMPOTENCY_TTL=24h
LINKUP_MIGRATIONS_DIR=../db/migrations

# Bounded in-memory authentication rate limiter for the single Ubuntu API process.
LINKUP_AUTH_RATE_LIMIT=10
LINKUP_AUTH_RATE_WINDOW=1m
LINKUP_AUTH_RATE_IDLE_TTL=10m
LINKUP_AUTH_RATE_MAX_ENTRIES=20000

# Optional provider-neutral SMTP recovery. If LINKUP_RECOVERY_SMTP_ADDR is set,
# the remaining fields are validated at startup. TLS is mandatory (STARTTLS by
# default; set implicit TLS for providers using SMTPS/465).
LINKUP_RECOVERY_SMTP_ADDR=
LINKUP_RECOVERY_SMTP_HOST=
LINKUP_RECOVERY_SMTP_USERNAME=
LINKUP_RECOVERY_SMTP_PASSWORD=
LINKUP_RECOVERY_FROM=
LINKUP_RECOVERY_RESET_URL=linkup://reset-password
LINKUP_RECOVERY_SMTP_IMPLICIT_TLS=false

# Argon2id floor. Benchmark on the target Ubuntu server before production and only increase from this floor.
LINKUP_ARGON_MEMORY_KIB=19456
LINKUP_ARGON_ITERATIONS=2
LINKUP_ARGON_PARALLELISM=1
