# Safe example only. Never commit real credentials.
LINKUP_HTTP_ADDR=:8080
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
LINKUP_SESSION_TTL=720h
LINKUP_PASSWORD_RESET_TTL=30m
LINKUP_REGISTRATION_TTL=20m
LINKUP_IDEMPOTENCY_TTL=24h

# How long a v1.1 WAITLIST queue position (a pending slot_requests row on a
# WAITLIST-access-mode Slot) stays eligible for FIFO promotion. Expired
# positions are never promoted and are lazily deleted the next time they are
# encountered (no background sweep); the requesting user can request again
# once their own position has expired. v1.0 APPROVAL requests are unaffected.
LINKUP_WAITLIST_REQUEST_TTL=48h
LINKUP_MIGRATIONS_DIR=../db/migrations

# v1.1 Notifications (README §6.8) — NotificationProjector settings. All have
# safe defaults if unset; only override when a product decision changes them.
# How long a projected notification stays eligible for push delivery before
# Decide() reports EXPIRED.
LINKUP_NOTIFICATION_TTL=336h
# Max recommendation/promo pushes to one user within the window below before
# Decide() reports SUPPRESSED_FREQUENCY_CAP. MESSAGE/SECURITY/EVENT/etc. are
# never frequency-capped (see internal/notification.Type.FrequencyCapped).
LINKUP_NOTIFICATION_FREQUENCY_CAP_MAX=5
LINKUP_NOTIFICATION_FREQUENCY_CAP_WINDOW=24h
# How often cmd/api's in-process worker polls domain_outbox_events for new
# notification-relevant events.
LINKUP_NOTIFICATION_POLL_INTERVAL=5s
# Max outbox events consumed per poll tick.
LINKUP_NOTIFICATION_BATCH_SIZE=200

# v1.1 BUMP proof baseline (README §6.9) — how long a server-issued
# anti-replay challenge nonce stays valid before internal/bump.Confirm
# rejects it as expired.
LINKUP_BUMP_CHALLENGE_TTL=10m

# v1.1 EVENT_REMINDER (README §6.8) — ReminderScanner settings.
# How long before a Slot's start_at a "starting soon" reminder is queued.
LINKUP_EVENT_REMINDER_LEAD_TIME=30m
# How often cmd/api's in-process scanner checks slots.start_at against now.
LINKUP_EVENT_REMINDER_POLL_INTERVAL=1m
# Max newly-eligible Slots claimed per scan tick.
LINKUP_EVENT_REMINDER_BATCH_SIZE=100

# v1.0 registration is Telegram-only for phone ownership verification.
# Configure all three together. The bot token and webhook secret are server-only
# secrets and must never be placed in Android resources, BuildConfig, logs or Git.
# Configure Telegram setWebhook to POST to:
#   https://<api-host>/v1/integrations/telegram/onboarding
# with secret_token equal to LINKUP_TELEGRAM_WEBHOOK_SECRET.
LINKUP_TELEGRAM_BOT_TOKEN=
LINKUP_TELEGRAM_BOT_USERNAME=
LINKUP_TELEGRAM_WEBHOOK_SECRET=

# Bounded in-memory authentication rate limiter for the single Ubuntu API process.
LINKUP_AUTH_RATE_LIMIT=10
LINKUP_AUTH_RATE_WINDOW=1m
LINKUP_AUTH_RATE_IDLE_TTL=10m
LINKUP_AUTH_RATE_MAX_ENTRIES=20000

# Bounded per-authenticated-user API budget. The limiter key is the canonical
# server user ID, never a user-controlled URL/slot identifier. This covers
# social mutations and polling reads without unbounded key growth.
LINKUP_SOCIAL_RATE_LIMIT=120
LINKUP_SOCIAL_RATE_WINDOW=1m
LINKUP_SOCIAL_RATE_IDLE_TTL=10m
LINKUP_SOCIAL_RATE_MAX_ENTRIES=20000

# Optional provider-neutral SMTP recovery. If LINKUP_RECOVERY_SMTP_ADDR is set,
# the remaining fields are validated at startup. TLS is mandatory (STARTTLS by
# default; set implicit TLS for providers using SMTPS/465). Reset URL must be an
# absolute HTTPS Android App Link origin/path; token is appended server-side.
LINKUP_RECOVERY_SMTP_ADDR=
LINKUP_RECOVERY_SMTP_HOST=
LINKUP_RECOVERY_SMTP_USERNAME=
LINKUP_RECOVERY_SMTP_PASSWORD=
LINKUP_RECOVERY_FROM=
LINKUP_RECOVERY_RESET_URL=https://app.example.com/reset-password
LINKUP_RECOVERY_SMTP_IMPLICIT_TLS=false

# Argon2id parameters are bounded by the backend security floor/ceiling.
# Current accepted ranges: memory 19456..262144 KiB, iterations 2..10,
# parallelism 1..8. Benchmark on the target Ubuntu server before production.
LINKUP_ARGON_MEMORY_KIB=19456
LINKUP_ARGON_ITERATIONS=2
LINKUP_ARGON_PARALLELISM=1
